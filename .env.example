# Codex Control Center runs locally and does not require an OpenAI API key.
CCC_HOST=127.0.0.1
CCC_PORT=8765
CCC_METADATA_ONLY=1

# Optional: override local app data directory.
# CCC_HOME=C:\Users\you\.codex-control-center

# Optional: protect mutating dashboard endpoints with a local token.
# CCC_CONTROL_TOKEN=replace-with-a-local-random-token

# Optional: protect local OTel ingest.
# CCC_OTEL_TOKEN=replace-with-a-local-random-token
